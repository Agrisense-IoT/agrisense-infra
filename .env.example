############################################################
# Agrisense — Environment Configuration
#
# Single source of truth for all service settings.
#
# !! BEFORE FIRST START !!
# 1. Copy this file to .env:   cp .env.example .env
# 2. Generate fresh secrets by running:
#      sh  ./supabase/docker/utils/generate-keys.sh   (Linux / macOS / WSL)
#      .\  supabase\docker\utils\generate-keys.ps1    (Windows PowerShell)
#
# 3. For LOCAL DEVELOPMENT (outside Docker), export DATABASE_URL / DIRECT_URL:
#      source ./supabase/docker/utils/generate-db-env.sh   (Linux / macOS / WSL)
#      npm run db:env                                       (Windows PowerShell)
#    Then run your dev server in the same terminal session.
#    Inside Docker these URLs are auto-constructed by docker-compose.yml.
#
# Docs: https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
############################################################


############################################################
# SECRETS — Generate all values below before first launch!
############################################################

# Symmetric signing secret used to issue JWT tokens
JWT_SECRET=<generate-a-random-secret>

# Pre-signed JWT tokens (anon = read-only public, service_role = full admin)
ANON_KEY=<generate-with-supabase-keygen>
SERVICE_ROLE_KEY=<generate-with-supabase-keygen>

# Encryption / signing keys for internal services
SECRET_KEY_BASE=<generate-a-random-base64-string>
VAULT_ENC_KEY=<generate-a-random-hex-string>
PG_META_CRYPTO_KEY=<generate-a-random-string>

# Analytics API tokens (Logflare)
LOGFLARE_PUBLIC_ACCESS_TOKEN=<generate-a-random-token>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<generate-a-random-token>

# S3 protocol endpoint credentials (used by Storage)
S3_PROTOCOL_ACCESS_KEY_ID=<generate-a-random-hex-string>
S3_PROTOCOL_ACCESS_KEY_SECRET=<generate-a-random-hex-string>


############################################################
# DASHBOARD — Supabase Studio access credentials
############################################################

DASHBOARD_USERNAME=<your-dashboard-username>
DASHBOARD_PASSWORD=<your-dashboard-password>


############################################################
# DATABASE — PostgreSQL configuration
############################################################

POSTGRES_HOST=db
POSTGRES_DB=agrisense_db
POSTGRES_PORT=5432
POSTGRES_PASSWORD=<generate-a-strong-password>

# Name of the internal Docker network shared between Supabase and the API.
# Supabase is NOT exposed to the host — only the API can reach it via this network.
DOCKER_NETWORK_NAME=agrisense_internal

# Host:port used when connecting to the DB from OUTSIDE Docker (local dev).
# Change this if your local Supabase pooler is on a different address.
# DATABASE_URL and DIRECT_URL are derived from this at runtime.
LOCAL_DB_HOST=127.0.0.1:5432


############################################################
# POOLER — Supavisor connection pooler
#
# Docs: https://supabase.com/docs/guides/self-hosting/docker#accessing-postgres
############################################################

# Unique tenant identifier (used as username suffix in pooled connections)
POOLER_TENANT_ID=agrisense

# Port for transaction-mode pooling (session mode uses POSTGRES_PORT)
POOLER_PROXY_PORT_TRANSACTION=6543

# Max PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20

# Max client connections Supavisor accepts per pool
POOLER_MAX_CLIENT_CONN=100

# Internal pool size for Supavisor's own metadata storage
POOLER_DB_POOL_SIZE=5


############################################################
# URLS — Hostnames / public-facing endpoints
#
# Update these to match your domain when deploying.
############################################################

# Public URL for the Supabase Dashboard and REST API
SUPABASE_PUBLIC_URL=http://localhost:8000

# External URL of the Auth service (used for OAuth callbacks, email links, etc.)
# Docs: https://supabase.com/docs/guides/auth/redirect-urls
API_EXTERNAL_URL=http://localhost:8000


############################################################
# API (NestJS) — Application settings
############################################################

# Port the NestJS application listens on
PORT=3143

# Set to true to run the database seeder on container startup
SEED=true

# Port the frontend listens on
FRONTEND_PORT=3000

# DATABASE_URL and DIRECT_URL are NOT set here.
# - Inside Docker  -> auto-constructed by docker-compose.yml from the POSTGRES_* / POOLER_* vars above.
# - Local dev      -> run `npm run db:env` (or .\utils\generate-db-env.ps1) to export them to your shell.


############################################################
# MQTT — Mosquitto broker
############################################################

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=


############################################################
# AUTH — GoTrue authentication server
############################################################

## General
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## SMTP
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=<your-smtp-username>
SMTP_PASS=<your-smtp-password>
SMTP_SENDER_NAME=Agrisense

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true


############################################################
# STORAGE — Supabase Storage configuration
#
# Docs: https://supabase.com/docs/guides/self-hosting/self-hosted-s3
############################################################

# S3 bucket name (or directory name when using 'file' backend)
GLOBAL_S3_BUCKET=stub

# Storage region identifier
REGION=stub

# Equivalent to project_ref for S3 session-token authentication
STORAGE_TENANT_ID=stub

# MinIO credentials (used with: docker compose -f docker-compose.yml -f docker-compose.s3.yml up)
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=<generate-a-strong-password>


############################################################
# STUDIO — Supabase Dashboard configuration
############################################################

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# Add your OpenAI API key to enable the AI Assistant feature in Studio
OPENAI_API_KEY=sk-proj-xxxxxxxx


############################################################
# ANALYTICS — Logflare log ingestion
#
# If Logflare is externally exposed, ensure keys above are strong!
############################################################

# Docker socket path (differs by OS; /var/run/docker.sock on Linux)
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud project details (required for GCS-backed Logflare)
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER


############################################################
# API GATEWAY — Kong configuration
############################################################

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############################################################
# EDGE FUNCTIONS — Supabase Functions
#
# Docs: https://supabase.com/docs/guides/self-hosting/self-hosted-functions
############################################################

# NOTE: This applies to ALL deployed edge functions
FUNCTIONS_VERIFY_JWT=false


############################################################
# API (PostgREST) — REST API configuration
############################################################

# Postgres schemas exposed via the REST API
PGRST_DB_SCHEMAS=public,storage,graphql_public


############################################################
# IMGPROXY — Image transformation service
############################################################

IMGPROXY_ENABLE_WEBP_DETECTION=true
