############################################################
# AgriSense — Environment Configuration
#
# Single source of truth for all service settings.
############################################################

## Secrets
# Generate all values below before first launch!


# JWT Secret: Symmetric signing secret used to issue and verify JWT tokens
JWT_SECRET=<generate-a-random-secret>

# Anon Key: Pre-signed read-only public JWT token (used by client-side SDKs)
ANON_KEY=<generate-with-supabase-keygen>
# Service Role Key: Pre-signed full-admin JWT token (used by server-side code only)
SERVICE_ROLE_KEY=<generate-with-supabase-keygen>

# Encryption Key Base: Secret key base for internal service encryption / cookie signing
SECRET_KEY_BASE=<generate-a-random-base64-string>
# Vault Encryption Key: Encryption key for the Supabase Vault (stored secrets)
VAULT_ENC_KEY=<generate-a-random-32-char-alphanumeric-string>
# Meta Crypto Key: Encryption key for Postgres Meta service
PG_META_CRYPTO_KEY=<generate-a-random-string>

# Logflare Public Token: Public API access token for Logflare analytics ingestion
LOGFLARE_PUBLIC_ACCESS_TOKEN=<generate-a-random-token>
# Logflare Private Token: Private API access token for Logflare admin operations
LOGFLARE_PRIVATE_ACCESS_TOKEN=<generate-a-random-token>

# Storage Access Key ID: S3-compatible access key ID for Supabase Storage
S3_PROTOCOL_ACCESS_KEY_ID=<generate-a-random-hex-string>
# Storage Access Secret: S3-compatible secret key for Supabase Storage
S3_PROTOCOL_ACCESS_KEY_SECRET=<generate-a-random-hex-string>


## Supabase Studio
# Access credentials for the Supabase Studio dashboard.

# Dashboard Username: Username for logging into the Supabase Studio web UI
DASHBOARD_USERNAME=<your-dashboard-username>
# Dashboard Password: Password for logging into the Supabase Studio web UI
DASHBOARD_PASSWORD=<your-dashboard-password>


## Database
# PostgreSQL engine configuration.

# Database Host: Internal Docker hostname of the PostgreSQL container
POSTGRES_HOST=db
# Database Name: Name of the PostgreSQL database
POSTGRES_DB=agrisense_db
# Database Port: Port PostgreSQL listens on inside the Docker network
POSTGRES_PORT=5432
# Database Password: Superuser password for the PostgreSQL database
POSTGRES_PASSWORD=<generate-a-strong-password>

# Network Name: Name of the internal Docker network shared between Supabase and the API.
DOCKER_NETWORK_NAME=agrisense_internal

# Local Database Host: Host:port used when connecting to the DB from OUTSIDE Docker (local dev).
LOCAL_DB_HOST=127.0.0.1:5432


## Connection Pooler
# Supavisor connection pooler settings.

# Pooler Tenant ID: Unique tenant identifier (used as username suffix in pooled connections)
POOLER_TENANT_ID=agrisense

# Transaction Port: Port for transaction-mode pooling (session mode uses POSTGRES_PORT)
POOLER_PROXY_PORT_TRANSACTION=6543

# Pool Size: Maximum PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20

# Max Client Connections: Maximum client connections Supavisor will accept per pool
POOLER_MAX_CLIENT_CONN=100

# Metadata Pool Size: Internal pool size for Supavisor's own metadata storage
POOLER_DB_POOL_SIZE=5


## Public Endpoints
# Public-facing URLs for services.

# Supabase Public URL: Public URL for the Supabase Dashboard and REST API
SUPABASE_PUBLIC_URL=http://localhost:8000

# Auth External URL: External URL of the Auth service (used for OAuth callbacks, email links, etc.)
API_EXTERNAL_URL=http://localhost:8000


## Source Repositories
# Repositories for backend and frontend services.

# Backend Repo: Git URL for the backend service repository
BACKEND_REPO=https://github.com/Agrisense-IoT/agrisense-backend.git
# Frontend Repo: Git URL for the frontend service repository
FRONTEND_REPO=https://github.com/Agrisense-IoT/agrisense-frontend.git


# Dev Mode Flag: Uncomment to start backend and frontend with hot reload.
# This variable is read by agrisense.ps1; it is not passed into the containers.
# Alternatively, pass -Development directly on the command line:
#   .\agrisense.ps1 -Development
#DEV_MODE=true

# Docker Compose Profiles:
# Use 'test' to run the backend test container.
# Example: COMPOSE_PROFILES=test
# Note: Mosquitto runs unconditionally — no profile needed.
COMPOSE_PROFILES=


## Application (NestJS API)
# Core API settings.

# API Port: Port the NestJS backend API listens on
PORT=3143

# Database Seeder: Set to true to run the database seeder on container startup
SEED=true


## Application (NextJS Frontend)
# Frontend UI settings.

# Frontend Port: Port the Next.js frontend listens on
FRONTEND_PORT=3000

# Next Public API URL: Public URL of the backend API — baked into the frontend image at build time.
NEXT_PUBLIC_API_URL=http://localhost:3143


## MQTT
# Mosquitto message broker setup.

# MQTT Host: Internal Docker hostname of the Mosquitto MQTT broker
MQTT_HOST=mosquitto
# MQTT Port: Port the MQTT broker listens on
MQTT_PORT=1883
# MQTT Username: Username for MQTT authentication (leave blank for anonymous)
MQTT_USERNAME=
# MQTT Password: Password for MQTT authentication (leave blank for anonymous)
MQTT_PASSWORD=


## Auth (GoTrue)

# Frontend Site URL: URL of the frontend site (used for email templates and redirects)
SITE_URL=http://localhost:3000
# Auth Redirect URLs: Comma-separated list of allowed OAuth/email redirect URLs
ADDITIONAL_REDIRECT_URLS=
# JWT Expiry: JWT token lifetime in seconds
JWT_EXPIRY=3600
# Disable Signup: Set to true to disable new user registration
DISABLE_SIGNUP=false
# Enable Guest Users: Set to true to allow anonymous/guest authentication
ENABLE_ANONYMOUS_USERS=false
# Enable Email Signup: Enable or disable email/password sign-up
ENABLE_EMAIL_SIGNUP=false
# Auto-confirm Email: Automatically confirm email addresses without verification
ENABLE_EMAIL_AUTOCONFIRM=false
# SMTP Admin Email: Admin email address shown as the sender
SMTP_ADMIN_EMAIL=admin@example.com
# SMTP Host: Hostname of the SMTP mail server
SMTP_HOST=supabase-mail
# SMTP Port: Port of the SMTP mail server
SMTP_PORT=2500
# SMTP User: SMTP authentication username
SMTP_USER=admin
# SMTP Pass: SMTP authentication password
SMTP_PASS=nimda
# SMTP Sender Name: Display name for outgoing emails
SMTP_SENDER_NAME=Agrisense
# Mailer URL Paths: Path suffixes appended to SITE_URL for auth email links
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
# Enable Phone Signup: Enable or disable phone/SMS sign-up
ENABLE_PHONE_SIGNUP=true
# Auto-confirm Phone: Automatically confirm phone numbers without verification
ENABLE_PHONE_AUTOCONFIRM=true


## Storage
# Supabase Storage & MinIO settings.

# S3 Bucket Name: S3 bucket name (or directory name when using 'file' backend)
GLOBAL_S3_BUCKET=stub

# Storage Region: Storage region identifier
REGION=stub

# Storage Tenant ID: Equivalent to project_ref for S3 session-token authentication
STORAGE_TENANT_ID=stub

# MinIO Root User: Root username for the MinIO S3-compatible object store
MINIO_ROOT_USER=supa-storage
# MinIO Root Password: Root password for the MinIO S3-compatible object store
MINIO_ROOT_PASSWORD=<generate-a-strong-password>


## Studio API
# Advanced Studio integrations.

# Organization Name: Default organization name shown in Supabase Studio
STUDIO_DEFAULT_ORGANIZATION=Default Organization
# Project Name: Default project name shown in Supabase Studio
STUDIO_DEFAULT_PROJECT=Default Project

# OpenAI API Key: OpenAI API key to enable the AI Assistant feature in Studio
OPENAI_API_KEY=sk-proj-xxxxxxxx


## Infrastructure
# Low-level infrastructure and gateway settings.

# Docker Socket: Docker socket path (differs by OS; /var/run/docker.sock on Linux)
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Project ID: Google Cloud project ID (required for GCS-backed Logflare)
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
# Google Project Number: Google Cloud project number (required for GCS-backed Logflare)
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER

# Kong HTTP Port: Kong API gateway HTTP port
KONG_HTTP_PORT=8000
# Kong HTTPS Port: Kong API gateway HTTPS port
KONG_HTTPS_PORT=8443

# Functions Verify JWT: Verify JWT tokens on edge function invocations
FUNCTIONS_VERIFY_JWT=false

# PostgREST Schemas: Postgres schemas exposed via the PostgREST REST API
PGRST_DB_SCHEMAS=public,storage,graphql_public

# Imgproxy WebP: Enable WebP format auto-detection for optimized image delivery
IMGPROXY_ENABLE_WEBP_DETECTION=true
